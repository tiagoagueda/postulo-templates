#. Printed in the header of an exported list: how many rows it holds.
#: src/postulo_templates/templates/postulo_templates/records/list.html
#, python-format
msgid "%(total)s row"
msgid_plural "%(total)s rows"
msgstr[0] "%(total)s redak"
msgstr[1] "%(total)s retka"
msgstr[2] "%(total)s redaka"

#. Label of a total: the average number of applications sent per week. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "A week, on average"
msgstr "Tjedno, u prosjeku"

#. Label before the name of the person's adviser at the employment office, in the details block at the top. In French: « Conseiller ou conseillère ».
#. Label before the name of the person's adviser at the employment office, in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Adviser"
msgstr "Savjetnik"

#: src/postulo_templates/plugin.py
msgid "Applicant tracking"
msgstr "Praćenje kandidata"

#. A note under the table of applications.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Applications drafted but never sent are not counted."
msgstr "Prijave koje su pripremljene, ali nikad poslane, ne računaju se."

#. Heading above the table of the job applications sent in the period, in a report laid out for France Travail. In French: « Candidatures ».
#. Label of a total: how many applications were sent in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Applications sent"
msgstr "Poslane prijave"

#. Table heading: the date the application was sent.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Applied on"
msgstr "Datum prijave"

#. Label of a total: how many appointments at the employment office the person attended. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Appointments attended"
msgstr "Posjećeni termini"

#. Table heading: the employer the application was sent to.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Company"
msgstr "Tvrtka"

#. The title at the top of the CV.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Curriculum Vitae"
msgstr "Curriculum Vitae"

#. Table heading: the date the application was sent. In French: « Date ».
#. Table heading: the day the interview took place. In French: « Date ».
#. Caption under an empty line on which the person writes the date by hand, at the end of the report.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Date"
msgstr "Datum"

#: src/postulo_templates/plugin.py
msgid "Document templates"
msgstr "Predlošci dokumenata"

#. The last line of a report laid out for France Travail. It must say plainly that the person made the list from their own records and that it is not an official France Travail form. Keep "France Travail" and "Postulo" as they are.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "Drawn up by the person named above from their own records, with Postulo. This is their own list, not a France Travail form."
msgstr ""

#. Table heading: the employer the interview was with. In French: « Entreprise ».
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "Employer"
msgstr ""

#. Table heading: the employer applied to, with the town of the job beneath. In French: « Entreprise et lieu ».
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "Employer and place"
msgstr ""

#. A level of the European Qualifications Framework (1 to 8) printed beside a qualification, for example EQF level 6.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
#, python-format
msgid "EQF level %(level)s"
msgstr "Razina EKO-a %(level)s"

#: src/postulo_templates/plugin.py
msgid "Europass layout"
msgstr "Izgled Europass"

#. Heading above the table that lists every application sent in the period, oldest first.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Every application, in order"
msgstr "Sve prijave, redom"

#. Label of a total: how many employers replied for the first time in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "First replies"
msgstr "Prvi odgovori"

#. Table heading: where the job was found, for example a job board or a contact.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Found via"
msgstr "Pronađeno putem"

#. Label before an empty line on which the person writes their France Travail identifier by hand. In French: « Identifiant France Travail ». Keep "France Travail" as it is: it is the name of the French public employment service.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "France Travail identifier"
msgstr ""

#: src/postulo_templates/plugin.py
#, fuzzy
msgid "Hand-over report"
msgstr "Izvješće za predaju"

#. Table heading: how the application was made, for example by email, on the company's website or through the employment service. In French: « Mode de candidature ».
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "How"
msgstr ""

#. Heading above a short list of totals for the period (applications sent, interviews).
#. Heading above a short list of totals for the period (applications sent, replies, interviews, offers).
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "In figures"
msgstr "U brojkama"

#. Label of a total: how many interviews the person attended in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Interviews attended"
msgstr "Posjećeni razgovori"

#. Heading above the table of the job interviews attended in the period, in a report laid out for France Travail. In French: « Entretiens d'embauche ».
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "Job interviews"
msgstr ""

#. The title at the top of the report handed to an employment service or adviser.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Job search report"
msgstr "Izvješće o traženju posla"

#. The name of a layout of the job-search report, in the list of layouts. It is laid out for France Travail, the French public employment service; keep "(France)". In French: « Relevé des démarches (France) ».
#: src/postulo_templates/plugin.py
msgid "Job-search steps (France)"
msgstr ""

#. Table heading: the kind of interview, for example by phone, by video or on site. In French: « Type d'entretien ».
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "Kind"
msgstr ""

#. Table heading: the date of the latest event on that application.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Last activity"
msgstr "Zadnja aktivnost"

#. A line under the languages table explaining that its levels (A1 to C2) follow the CEFR.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Levels: Common European Framework of Reference for Languages"
msgstr "Razine: Zajednički europski referentni okvir za jezike"

#: src/postulo_templates/plugin.py
msgid "More themes to set a CV or a portfolio in, beside Postulo's own: one a hiring system reads cleanly and one laid out as the Europass CV is. Switched off, the themes are no longer offered, and a document set in one of them is drawn in the plain theme until it is switched on again."
msgstr "Više tema za oblikovanje životopisa ili portfolija, uz Postulove vlastite: jedna koju sustav za zapošljavanje čisto čita i jedna oblikovana kao Europass životopis. Kad su isključene, teme se više ne nude, a dokument oblikovan u jednoj od njih crta se u običnoj temi dok se ponovno ne uključe."

#. Label before the person's first language(s) in the languages section; the (s) is for one or several.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Mother tongue(s)"
msgstr "Materinski jezik (jezici)"

#. Label before the name of the person the report is about, in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Name"
msgstr "Ime i prezime"

#. Printed in the header of an exported list, before the filters that narrowed it (for example status: interview).
#: src/postulo_templates/templates/postulo_templates/records/list.html
msgid "Narrowed by"
msgstr "Filtrirano prema"

#. Said in place of the table of interviews when none took place in the period.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "No interview in this period."
msgstr ""

#. Table heading of the first column: the row number, abbreviated. Keep it very short; it sits above a one- or two-digit number.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "No."
msgstr "Br."

#. Said in place of an exported list when no row matches the filters.
#: src/postulo_templates/templates/postulo_templates/records/list.html
msgid "Nothing matches."
msgstr "Nema podudaranja."

#. Said in place of the table when no application was sent in the period.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Nothing was sent in this period."
msgstr "U ovom razdoblju ništa nije poslano."

#. Label of a total: how many job offers were received in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Offers"
msgstr "Ponude"

#. Label before the name of the employment office the report is for, in the details block at the top. In French: « Agence ».
#. Label before the name of the employment office the report is for, in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Office"
msgstr "Ured"

#. Label before the other languages the person speaks; the (s) is for one or several.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Other language(s)"
msgstr "Drugi jezik (jezici)"

#. Label before the dates the report covers (for example March 2026), in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Period"
msgstr "Razdoblje"

#. Heading of the section with the person's contact details, in a CV laid out as the Europass CV is.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Personal information"
msgstr "Osobni podaci"

#. Heading of the section holding the person's summary of themselves.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Personal statement"
msgstr "Osobni sažetak"

#. Label of the portfolio, the document type, printed on a CV-like page that lists the person's projects first.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Portfolio"
msgstr "Portfolio"

#. Table heading: the job title applied for. In French: « Poste ».
#. Table heading: the job title the interview was for. In French: « Poste ».
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "Position"
msgstr ""

#: src/postulo_templates/plugin.py
msgid "Postulo Templates"
msgstr "Predlošci za Postulo"

#. Printed after a dash where a job or study has no end date: for example March 2019 - present.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "present"
msgstr "danas"

#: src/postulo_templates/plugin.py
msgid "Printed calendar"
msgstr "Ispisani kalendar"

#. Label before the date and time the report was produced, in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Produced"
msgstr "Izrađeno"

#. Printed in the header of an exported list: the date and time it was produced.
#: src/postulo_templates/templates/postulo_templates/records/list.html
#, fuzzy, python-format
msgid "Produced on %(produced)s"
msgstr "Izrađeno %(produced)s"

#. The title of a job-search report laid out for France Travail, the French public employment service. The official French term is « démarches de recherche d'emploi »; in French the title reads « Relevé des démarches de recherche d'emploi ».
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "Record of job-search steps"
msgstr ""

#: src/postulo_templates/plugin.py
msgid "Records list"
msgstr "Popis zapisa"

#. A closing line of the CV.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "References are available on request."
msgstr "Preporuke su dostupne na zahtjev."

#. Label of a total: how many applications were turned down in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Rejections"
msgstr "Odbijenice"

#. Table heading: where the application stands now, with the date of the latest event. In French: « Suite donnée » or « Résultat ».
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "Result"
msgstr ""

#. Table heading: the job title applied for.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Role"
msgstr "Radno mjesto"

#. Caption under an empty line on which the person signs by hand, at the end of the report.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Signature"
msgstr "Potpis"

#. Caption under an empty line on which the person writes by hand the town where they sign, at the end of a report laid out for France Travail. In French: « Fait à ».
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "Signed at"
msgstr ""

#. Table heading: where the application stands, for example sent, interview or rejected.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Status"
msgstr "Status"

#. Printed in the header of an exported list that was cut short: how many rows are shown out of how many there are.
#: src/postulo_templates/templates/postulo_templates/records/list.html
#, python-format
msgid "The first %(count)s of %(total)s rows; the rest are in the table."
msgstr "Prvih %(count)s od ukupno %(total)s redaka; ostali su u tablici."

#. A note under the table of applications, in a report laid out for France Travail. France Travail asks for the copies of the applications and the employers' replies as proof; this list only summarises them.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
msgid "This list summarises the applications. The copies of the applications and the employers' replies are the supporting documents."
msgstr ""

#. Label of a total: how many applications were sent through the public employment service. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/demarches/report.html
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Through the public employment service"
msgstr "Putem javne službe za zapošljavanje"

#. Label of a total: how many weeks of the period had no application sent. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
#, fuzzy
msgid "Weeks with none"
msgstr "Tjedni bez ijedne"
