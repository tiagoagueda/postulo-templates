#. Printed in the header of an exported list: how many rows it holds.
#: src/postulo_templates/templates/postulo_templates/records/list.html
#, python-format
msgid "%(total)s row"
msgid_plural "%(total)s rows"
msgstr[0] "%(total)s rhes"
msgstr[1] "%(total)s res"
msgstr[2] "%(total)s rhes"
msgstr[3] "%(total)s rhes"

#. Label of a total: the average number of applications sent per week. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "A week, on average"
msgstr "Yr wythnos, ar gyfartaledd"

#. Label before the name of the person's adviser at the employment office, in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
#, fuzzy
msgid "Adviser"
msgstr "Cynghorydd"

#: src/postulo_templates/plugin.py
msgid "Applicant tracking"
msgstr "Olrhain ymgeiswyr"

#. A note under the table of applications.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Applications drafted but never sent are not counted."
msgstr "Nid yw ceisiadau a ddrafftiwyd ond na chawsant eu hanfon byth yn cael eu cyfrif."

#. Label of a total: how many applications were sent in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Applications sent"
msgstr "Ceisiadau a anfonwyd"

#. Table heading: the date the application was sent.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Applied on"
msgstr "Dyddiad gwneud cais"

#. Label of a total: how many appointments at the employment office the person attended. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Appointments attended"
msgstr "Apwyntiadau a fynychwyd"

#. Table heading: the employer the application was sent to.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Company"
msgstr "Cwmni"

#. The title at the top of the CV.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Curriculum Vitae"
msgstr "Curriculum Vitae"

#. Caption under an empty line on which the person writes the date by hand, at the end of the report.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Date"
msgstr "Dyddiad"

#: src/postulo_templates/plugin.py
msgid "Document templates"
msgstr "Templedi dogfennau"

#. A level of the European Qualifications Framework (1 to 8) printed beside a qualification, for example EQF level 6.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
#, python-format
msgid "EQF level %(level)s"
msgstr "Lefel %(level)s EQF"

#: src/postulo_templates/plugin.py
msgid "Europass layout"
msgstr "Cynllun Europass"

#. Heading above the table that lists every application sent in the period, oldest first.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Every application, in order"
msgstr "Pob cais, yn eu trefn"

#. Label of a total: how many employers replied for the first time in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "First replies"
msgstr "Ymatebion cyntaf"

#. Table heading: where the job was found, for example a job board or a contact.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Found via"
msgstr "Wedi'i ganfod drwy"

#: src/postulo_templates/plugin.py
#, fuzzy
msgid "Hand-over report"
msgstr "Adroddiad trosglwyddo"

#. Heading above a short list of totals for the period (applications sent, replies, interviews, offers).
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "In figures"
msgstr "Mewn ffigurau"

#. Label of a total: how many interviews the person attended in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Interviews attended"
msgstr "Cyfweliadau a fynychwyd"

#. The title at the top of the report handed to an employment service or adviser.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Job search report"
msgstr "Adroddiad chwilio am waith"

#. Table heading: the date of the latest event on that application.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Last activity"
msgstr "Gweithgarwch diwethaf"

#. A line under the languages table explaining that its levels (A1 to C2) follow the CEFR.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Levels: Common European Framework of Reference for Languages"
msgstr "Lefelau: Fframwaith Cyfeirio Ewropeaidd Cyffredin ar gyfer Ieithoedd"

#: src/postulo_templates/plugin.py
#, fuzzy
msgid "More themes to set a CV or a portfolio in, beside Postulo's own: one a hiring system reads cleanly and one laid out as the Europass CV is. Switched off, the themes are no longer offered, and a document set in one of them is drawn in the plain theme until it is switched on again."
msgstr "Mwy o themâu i lunio CV neu bortffolio ynddynt, yn ogystal â rhai Postulo ei hun: un y mae system recriwtio yn ei darllen yn lân ac un wedi'i gosod fel y CV Europass. Pan fyddant wedi'u diffodd, ni chynigir y themâu mwyach, a chaiff dogfen a osodwyd mewn un ohonynt ei thynnu yn y thema blaen nes eu troi ymlaen eto."

#. Label before the person's first language(s) in the languages section; the (s) is for one or several.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Mother tongue(s)"
msgstr "Mamiaith (mamieithoedd)"

#. Label before the name of the person the report is about, in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Name"
msgstr "Enw"

#. Printed in the header of an exported list, before the filters that narrowed it (for example status: interview).
#: src/postulo_templates/templates/postulo_templates/records/list.html
#, fuzzy
msgid "Narrowed by"
msgstr "Culhawyd yn ôl"

#. Table heading of the first column: the row number, abbreviated. Keep it very short; it sits above a one- or two-digit number.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "No."
msgstr "Rhif"

#. Said in place of an exported list when no row matches the filters.
#: src/postulo_templates/templates/postulo_templates/records/list.html
msgid "Nothing matches."
msgstr "Dim yn cyfateb."

#. Said in place of the table when no application was sent in the period.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Nothing was sent in this period."
msgstr "Ni anfonwyd dim yn y cyfnod hwn."

#. Label of a total: how many job offers were received in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Offers"
msgstr "Cynigion"

#. Label before the name of the employment office the report is for, in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
#, fuzzy
msgid "Office"
msgstr "Swyddfa"

#. Label before the other languages the person speaks; the (s) is for one or several.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Other language(s)"
msgstr "Ieithoedd eraill"

#. Label before the dates the report covers (for example March 2026), in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Period"
msgstr "Cyfnod"

#. Heading of the section with the person's contact details, in a CV laid out as the Europass CV is.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Personal information"
msgstr "Gwybodaeth bersonol"

#. Heading of the section holding the person's summary of themselves.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Personal statement"
msgstr "Datganiad personol"

#. Label of the portfolio, the document type, printed on a CV-like page that lists the person's projects first.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "Portfolio"
msgstr "Portffolio"

#: src/postulo_templates/plugin.py
msgid "Postulo Templates"
msgstr "Postulo Templates"

#. Printed after a dash where a job or study has no end date: for example March 2019 - present.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "present"
msgstr "presennol"

#: src/postulo_templates/plugin.py
msgid "Printed calendar"
msgstr "Calendr printiedig"

#. Label before the date and time the report was produced, in the details block at the top.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Produced"
msgstr "Cynhyrchwyd"

#. Printed in the header of an exported list: the date and time it was produced.
#: src/postulo_templates/templates/postulo_templates/records/list.html
#, python-format
msgid "Produced on %(produced)s"
msgstr "Cynhyrchwyd ar %(produced)s"

#: src/postulo_templates/plugin.py
#, fuzzy
msgid "Records list"
msgstr "Rhestr cofnodion"

#. A closing line of the CV.
#: src/postulo_templates/templates/postulo_templates/europass/cv.html
msgid "References are available on request."
msgstr "Mae geirdaon ar gael ar gais."

#. Label of a total: how many applications were turned down in the period. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Rejections"
msgstr "Gwrthodiadau"

#. Table heading: the job title applied for.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Role"
msgstr "Rôl"

#. Caption under an empty line on which the person signs by hand, at the end of the report.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Signature"
msgstr "Llofnod"

#. Table heading: where the application stands, for example sent, interview or rejected.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Status"
msgstr "Statws"

#. Printed in the header of an exported list that was cut short: how many rows are shown out of how many there are.
#: src/postulo_templates/templates/postulo_templates/records/list.html
#, python-format
msgid "The first %(count)s of %(total)s rows; the rest are in the table."
msgstr "Y %(count)s cyntaf o %(total)s rhes; mae'r gweddill yn y tabl."

#. Label of a total: how many applications were sent through the public employment service. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Through the public employment service"
msgstr "Drwy'r gwasanaeth cyflogaeth cyhoeddus"

#. A throwaway probe for the Weblate round trip (#10); never drawn, removed again at once.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Weblate round-trip probe"
msgstr ""

#. Label of a total: how many weeks of the period had no application sent. The number comes before it.
#: src/postulo_templates/templates/postulo_templates/handover/report.html
msgid "Weeks with none"
msgstr "Wythnosau heb ddim"
